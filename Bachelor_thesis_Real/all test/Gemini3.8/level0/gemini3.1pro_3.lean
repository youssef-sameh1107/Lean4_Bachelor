import Mathlib.Tactic
import Mathlib.Computability.RegularExpressions
import Mathlib.Computability.Language

namespace FormalLanguages

variable {α : Type*}

#count_heartbeats in --10
/--
We define a language to be regular if it is generated by a regular expression.
 Note: Mathlib's `Mathlib.Computability.DFA` also defines regularity via
Deterministic Finite Automata. Using the structural regex definition makes
proving closure properties straightforward.
 -/
def IsRegular (L : Language α) : Prop :=
  ∃ r : RegularExpression α, r.matches' = L

/--
Theorem: Regular languages are closed under concatenation.
 -/

#count_heartbeats in --18 heartbeats
theorem isRegular_mul {L M : Language α} (hL : IsRegular L) (hM : IsRegular M) :
    IsRegular (L * M) := by
  -- Extract the underlying regular expressions that generate L and M
  rcases hL with ⟨rL, hrL⟩
  rcases hM with ⟨rM, hrM⟩

  -- The concatenated language is generated by the product of the regular expressions
  use rL * rM

  -- Substitute the languages with their regular expression matches
  rw [← hrL, ← hrM]

  -- Mathlib provides the exact theorem linking regex multiplication to language multiplication

  exact RegularExpression.matches'_mul rL rM

end FormalLanguages

#print axioms FormalLanguages.isRegular_mul

